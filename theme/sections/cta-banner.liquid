{%- comment -%}
  DIBI CTA banner — closing call to action.
  No image: centered heading + subtext + button.
  Image set: side-image layout matching the "Gift of Glowing Skin" block in
  hydrogen/app/routes/_index.tsx (text column + image column).
  Button falls back to the booking WhatsApp link when no link is set.
{%- endcomment -%}

{%- liquid
  if section.settings.cta_link != blank
    assign cta_href = section.settings.cta_link
    assign cta_target = ''
  else
    capture cta_href
      render 'booking-url'
    endcapture
    assign cta_href = cta_href | strip
    assign cta_target = 'blank'
  endif

  assign has_image = false
  if section.settings.image != blank or section.settings.image_url != blank
    assign has_image = true
  endif
-%}

{%- if has_image -%}
  <section
    class="dibi-cta dibi-cta--split dibi-cta--image-{{ section.settings.image_position }}"
    id="dibi-cta-{{ section.id }}"
  >
    <div class="dibi-cta__split dibi-reveal">
      <div class="dibi-cta__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="dibi-cta__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <div class="dibi-cta__subtext">{{ section.settings.subtext }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a
            href="{{ cta_href }}"
            class="dibi-cta__button"
            {% if cta_target == 'blank' %}target="_blank" rel="noopener"{% endif %}
          >
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      <div class="dibi-cta__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 50vw, 100vw',
              widths: '400, 600, 800, 1000, 1200',
              class: 'dibi-cta__img',
              alt: section.settings.heading
          }}
        {%- elsif section.settings.image_url != blank -%}
          <img
            src="{{ section.settings.image_url }}"
            alt="{{ section.settings.heading | escape }}"
            class="dibi-cta__img"
            loading="lazy"
            width="1200"
            height="900"
          >
        {%- endif -%}
      </div>
    </div>
  </section>
{%- else -%}
  <section class="dibi-cta" id="dibi-cta-{{ section.id }}">
    <div class="dibi-cta__inner dibi-reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="dibi-cta__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <div class="dibi-cta__subtext">{{ section.settings.subtext }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a
          href="{{ cta_href }}"
          class="dibi-cta__button"
          {% if cta_target == 'blank' %}target="_blank" rel="noopener"{% endif %}
        >
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "CTA banner",
  "tag": "section",
  "class": "dibi-cta-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift of Glowing Skin"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Treat someone special to a bespoke skin experience. Our beautifully packaged gift cards can be used towards any treatment or product in our clinic.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Book Consultation"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Leave blank to use the WhatsApp booking link."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "When set, the banner uses a side-image layout. Leave blank for centered text."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (fallback)",
      "info": "External image URL used when no image is uploaded above."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "info": "Only used when an image is set.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    }
  ],
  "presets": [
    {
      "name": "CTA banner"
    }
  ]
}
{% endschema %}
