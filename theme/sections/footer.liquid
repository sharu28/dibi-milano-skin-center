{%- comment -%}
  DIBI Milano footer — matches hydrogen/app/components/Footer.tsx
  Columns: brand blurb + contact details, then editable block columns
  (Quick Links etc.). Contact pulls phone/email/WhatsApp from theme
  settings. Book Online uses the WhatsApp booking deep link.
{%- endcomment -%}

<footer class="dibi-footer">
  <div class="dibi-footer__inner">
    <div class="dibi-footer__grid">
      {%- comment -%} Brand + contact (spans two columns) {%- endcomment -%}
      <div class="dibi-footer__brand">
        <div>
          <h2 class="dibi-footer__brand-title">{{ section.settings.brand_title | default: 'DIBI Milano' }}</h2>
          {%- if section.settings.brand_subtitle != blank -%}
            <p class="dibi-footer__brand-sub">{{ section.settings.brand_subtitle }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.brand_blurb != blank -%}
          <div class="dibi-footer__blurb rte">{{ section.settings.brand_blurb }}</div>
        {%- endif -%}

        <div class="dibi-footer__contact">
          {%- if section.settings.address != blank -%}
            <div class="dibi-footer__contact-row">
              {% render 'dibi-icon-map-pin' %}
              <span>{{ section.settings.address }}</span>
            </div>
          {%- endif -%}

          {%- if settings.dibi_phone != blank -%}
            <div class="dibi-footer__contact-row">
              {% render 'dibi-icon-phone' %}
              <a href="{{ settings.dibi_phone_href | default: 'tel:' }}">{{ settings.dibi_phone }}</a>
            </div>
          {%- endif -%}

          {%- if settings.dibi_whatsapp_number != blank -%}
            <div class="dibi-footer__contact-row">
              {% render 'dibi-icon-message' %}
              <a href="https://wa.me/{{ settings.dibi_whatsapp_number }}" target="_blank" rel="noopener">
                +{{ settings.dibi_whatsapp_number }}
              </a>
            </div>
          {%- endif -%}

          {%- if settings.dibi_email != blank -%}
            <div class="dibi-footer__contact-row">
              {% render 'dibi-icon-mail' %}
              <a href="mailto:{{ settings.dibi_email }}">{{ settings.dibi_email }}</a>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Editable link columns {%- endcomment -%}
      {%- for block in section.blocks -%}
        <div class="dibi-footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3 class="dibi-footer__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'quick_links' -%}
              <ul class="dibi-footer__links">
                {%- if block.settings.show_home -%}
                  <li><a href="{{ routes.root_url }}">Home</a></li>
                {%- endif -%}
                {%- if block.settings.show_products -%}
                  <li><a href="{{ routes.all_products_collection_url }}">Products</a></li>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                {%- endif -%}
                {%- if block.settings.show_book_online -%}
                  <li>
                    <a href="{% render 'booking-url' %}" target="_blank" rel="noopener">Book Online</a>
                  </li>
                {%- endif -%}
              </ul>

            {%- when 'link_list' -%}
              {%- if block.settings.menu != blank -%}
                <ul class="dibi-footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="dibi-footer__blurb rte">{{ block.settings.content }}</div>

            {%- when 'hours' -%}
              {%- if block.settings.content != blank -%}
                <div class="dibi-footer__hours rte">{{ block.settings.content }}</div>
              {%- endif -%}

              {%- if section.settings.social_instagram != blank or section.settings.social_facebook != blank -%}
                <div class="dibi-footer__social">
                  {%- if block.settings.social_heading != blank -%}
                    <h3 class="dibi-footer__heading">{{ block.settings.social_heading }}</h3>
                  {%- endif -%}
                  <div class="dibi-footer__social-links">
                    {%- if section.settings.social_instagram != blank -%}
                      <a class="dibi-footer__social-link" href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                        {% render 'dibi-icon-instagram' %}
                      </a>
                    {%- endif -%}
                    {%- if section.settings.social_facebook != blank -%}
                      <a class="dibi-footer__social-link" href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                        {% render 'dibi-icon-facebook' %}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.map_embed_url != blank -%}
      <div class="dibi-footer__map">
        <iframe
          src="{{ section.settings.map_embed_url }}"
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="{{ section.settings.map_title | default: 'DIBI Milano Location' | escape }}"
        ></iframe>
      </div>
    {%- endif -%}

    <div class="dibi-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_title | default: shop.name }}. All rights reserved.</p>
      {%- if section.settings.show_policies -%}
        <ul class="dibi-footer__policies">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "quick_links",
      "name": "Quick Links",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "checkbox",
          "id": "show_home",
          "label": "Show Home",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_products",
          "label": "Show Products",
          "default": true
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Additional links"
        },
        {
          "type": "checkbox",
          "id": "show_book_online",
          "label": "Show Book Online (WhatsApp)",
          "default": true
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "hours",
      "name": "Opening Hours",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Opening Hours"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Hours",
          "default": "<p>Monday - Sunday  9:00 AM - 6:30 PM</p><p>Open on Poya Days</p>"
        },
        {
          "type": "header",
          "content": "Follow Us"
        },
        {
          "type": "text",
          "id": "social_heading",
          "label": "Social heading",
          "default": "Follow Us"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand title",
      "default": "DIBI Milano"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Brand subtitle",
      "default": "Skin Center"
    },
    {
      "type": "richtext",
      "id": "brand_blurb",
      "label": "Brand blurb",
      "default": "<p>Elevating your natural beauty through bespoke skin treatments and advanced technology in the heart of Colombo.</p>"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "No 10, 2nd Floor, Dasa Group Building, Rosmead Place, Colombo 7"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "text",
      "id": "social_instagram",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/dibimilano_skincentre"
    },
    {
      "type": "text",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "textarea",
      "id": "map_embed_url",
      "label": "Google Maps embed URL",
      "info": "Paste the src URL from a Google Maps embed iframe.",
      "default": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3960.817578298918!2d79.86379531537456!3d6.912411995005934!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ae2597022026115%3A0x633d1b8222a0335e!2s10%20Rosmead%20Pl%2C%20Colombo%2000700%2C%20Sri%20Lanka!5e0!3m2!1sen!2sus!4v1650000000000!5m2!1sen!2sus"
    },
    {
      "type": "text",
      "id": "map_title",
      "label": "Map iframe title",
      "default": "DIBI Milano Location"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show shop policy links",
      "default": true
    }
  ],
  "default": {
    "blocks": [
      { "type": "quick_links" },
      { "type": "hours" }
    ]
  }
}
{% endschema %}
