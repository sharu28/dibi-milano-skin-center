{%- comment -%}
  DIBI Milano header — matches hydrogen/app/components/Navbar.tsx
  Solid white background, centered brand lockup, split desktop nav,
  Services dropdown, BOOK ONLINE plain-text CTA (WhatsApp), mobile drawer.
{%- endcomment -%}

{%- assign services_menu = section.settings.services_menu -%}

<header
  class="dibi-header{% if section.settings.sticky %} dibi-header--sticky{% endif %}"
  data-dibi-header
>
  <div class="dibi-header__inner">
    {%- comment -%} Left nav (desktop) {%- endcomment -%}
    <nav class="dibi-nav dibi-nav--left" aria-label="Primary">
      <a class="dibi-nav__link" href="{{ routes.root_url }}">HOME</a>
      <a class="dibi-nav__link" href="{{ routes.all_products_collection_url }}">PRODUCTS</a>

      {%- if services_menu != blank and services_menu.links.size > 0 -%}
        <div class="dibi-nav__services">
          <button type="button" class="dibi-nav__link dibi-nav__services-toggle" aria-haspopup="true">
            SERVICES
            {% render 'dibi-icon-chevron' %}
          </button>
          <div class="dibi-nav__services-menu">
            <div class="dibi-nav__services-inner">
              {%- for link in services_menu.links -%}
                <a class="dibi-nav__services-link" href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}

      <a
        class="dibi-nav__cta"
        href="{% render 'booking-url' %}"
        target="_blank"
        rel="noopener"
      >BOOK ONLINE</a>
    </nav>

    {%- comment -%} Centered brand {%- endcomment -%}
    <a class="dibi-header__brand" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_width = section.settings.logo_width | default: 120 -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'dibi-header__logo-img',
            widths: '120, 240, 360, 480, 600',
            sizes: logo_width | append: 'px',
            alt: section.settings.brand_title | default: shop.name
        }}
      {%- else -%}
        <span class="dibi-header__brand-title">{{ section.settings.brand_title | default: 'DIBI Milano' }}</span>
        {%- if section.settings.brand_subtitle != blank -%}
          <span class="dibi-header__brand-sub">{{ section.settings.brand_subtitle }}</span>
        {%- endif -%}
      {%- endif -%}
    </a>

    {%- comment -%} Right nav (desktop) {%- endcomment -%}
    <nav class="dibi-nav dibi-nav--right" aria-label="Secondary">
      <a class="dibi-nav__link" href="{{ section.settings.gallery_url | default: '/pages/gallery' }}">GALLERY</a>
      <a class="dibi-nav__link" href="{{ section.settings.training_url | default: '/pages/training' }}">TRAINING</a>
      <a class="dibi-nav__link" href="{{ section.settings.careers_url | default: '/pages/careers' }}">CAREERS</a>
    </nav>

    {%- comment -%} Mobile toggle {%- endcomment -%}
    <button
      type="button"
      class="dibi-header__mobile-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      data-dibi-menu-toggle
    >
      <span data-dibi-icon-menu>{% render 'dibi-icon-menu' %}</span>
      <span data-dibi-icon-close hidden>{% render 'dibi-icon-close' %}</span>
    </button>
  </div>

  {%- comment -%} Mobile drawer {%- endcomment -%}
  <div class="dibi-mobile-menu" data-dibi-mobile-menu>
    <div class="dibi-mobile-menu__list">
      <a class="dibi-mobile-menu__link" href="{{ routes.root_url }}">HOME</a>
      <a class="dibi-mobile-menu__link" href="{{ routes.all_products_collection_url }}">PRODUCTS</a>
      <a class="dibi-mobile-menu__link" href="{{ section.settings.gallery_url | default: '/pages/gallery' }}">GALLERY</a>

      {%- if services_menu != blank and services_menu.links.size > 0 -%}
        <div>
          <button
            type="button"
            class="dibi-mobile-menu__services-toggle"
            aria-expanded="false"
            data-dibi-mobile-services-toggle
          >
            SERVICES
            {% render 'dibi-icon-chevron' %}
          </button>
          <div class="dibi-mobile-menu__sublist" data-dibi-mobile-services>
            {%- for link in services_menu.links -%}
              <a class="dibi-mobile-menu__sublink" href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <a class="dibi-mobile-menu__link" href="{{ section.settings.training_url | default: '/pages/training' }}">TRAINING</a>
      <a class="dibi-mobile-menu__link" href="{{ section.settings.careers_url | default: '/pages/careers' }}">CAREERS</a>
      <a
        class="dibi-mobile-menu__link"
        href="{% render 'booking-url' %}"
        target="_blank"
        rel="noopener"
      >BOOK ONLINE</a>
    </div>
  </div>
</header>

<script>
  (function () {
    var header = document.querySelector('[data-dibi-header]');
    if (!header) return;

    var toggle = header.querySelector('[data-dibi-menu-toggle]');
    var menu = header.querySelector('[data-dibi-mobile-menu]');
    var iconMenu = header.querySelector('[data-dibi-icon-menu]');
    var iconClose = header.querySelector('[data-dibi-icon-close]');

    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        var open = menu.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (iconMenu) iconMenu.hidden = open;
        if (iconClose) iconClose.hidden = !open;
      });
    }

    var servicesToggle = header.querySelector('[data-dibi-mobile-services-toggle]');
    var servicesList = header.querySelector('[data-dibi-mobile-services]');
    if (servicesToggle && servicesList) {
      servicesToggle.addEventListener('click', function () {
        var open = servicesList.classList.toggle('is-open');
        servicesToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand title (text logo)",
      "default": "DIBI Milano"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Brand subtitle",
      "default": "Skin Center"
    },
    {
      "type": "link_list",
      "id": "services_menu",
      "label": "Services menu"
    },
    {
      "type": "header",
      "content": "Right-side links"
    },
    {
      "type": "url",
      "id": "gallery_url",
      "label": "Gallery URL"
    },
    {
      "type": "url",
      "id": "training_url",
      "label": "Training URL"
    },
    {
      "type": "url",
      "id": "careers_url",
      "label": "Careers URL"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    }
  ]
}
{% endschema %}
