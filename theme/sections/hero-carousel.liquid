{%- comment -%}
  DIBI hero carousel — matches hydrogen/app/routes/_index.tsx hero section.
  Stacked image slides with opacity crossfade, dark overlay, centered
  heading/subhead/CTA. CTA falls back to the booking WhatsApp link.
{%- endcomment -%}

{%- liquid
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign interval = section.settings.interval_ms
  if section.settings.cta_link != blank
    assign cta_href = section.settings.cta_link
    assign cta_target = ''
  else
    capture cta_href
      render 'booking-url'
    endcapture
    assign cta_href = cta_href | strip
    assign cta_target = 'blank'
  endif
-%}

<section
  class="dibi-hero"
  id="dibi-hero-{{ section.id }}"
  style="--dibi-hero-overlay: {{ overlay }};"
>
  <div class="dibi-hero__slides" data-dibi-hero-slides>
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <div
          class="dibi-hero__slide{% if forloop.first %} is-active{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 2200
              | image_tag:
                loading: 'eager',
                sizes: '100vw',
                widths: '750, 1100, 1500, 2200',
                alt: block.settings.alt,
                class: 'dibi-hero__img'
            }}
          {%- else -%}
            <div class="dibi-hero__img dibi-hero__img--placeholder">
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'dibi-hero__placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
    <div class="dibi-hero__overlay"></div>
  </div>

  <div class="dibi-hero__content dibi-reveal">
    {%- if section.settings.heading != blank -%}
      <h1 class="dibi-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="dibi-hero__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div class="dibi-hero__cta-wrap">
        <a
          href="{{ cta_href }}"
          class="dibi-hero__cta"
          {% if cta_target == 'blank' %}target="_blank" rel="noopener"{% endif %}
        >
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('dibi-hero-{{ section.id }}');
    if (!root) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var slides = root.querySelectorAll('[data-dibi-hero-slides] .dibi-hero__slide');
    if (slides.length < 2) return;
    var i = 0;
    setInterval(function () {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    }, {{ interval | default: 5000 }});
  })();
</script>

{% schema %}
{
  "name": "Hero carousel",
  "tag": "section",
  "class": "dibi-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Natural Beauty"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Bespoke skin treatments tailored to your unique needs in the heart of Colombo.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Book Consultation"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Leave blank to use the WhatsApp booking link."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "number",
      "id": "interval_ms",
      "label": "Slide interval (ms)",
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
