{%- comment -%}
  DIBI Instagram feed — matches the Instagram grid in
  hydrogen/app/routes/_index.tsx. Static images (no Instagram API).
  Each post block: image + link. Section footer links to the profile.
{%- endcomment -%}

{%- liquid
  assign ig_url = section.settings.instagram_url
  if ig_url == blank
    assign ig_url = '#'
  endif
-%}

<section class="dibi-instagram" id="dibi-instagram-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="dibi-instagram__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="dibi-instagram__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'post' -%}
        {%- liquid
          assign post_url = block.settings.link
          if post_url == blank
            assign post_url = ig_url
          endif
        -%}
        <a
          href="{{ post_url }}"
          class="dibi-instagram__post"
          target="_blank"
          rel="noopener noreferrer"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 750px) 25vw, 50vw',
                widths: '300, 500, 800',
                alt: 'Instagram post',
                class: 'dibi-instagram__img'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'dibi-instagram__img dibi-instagram__img--placeholder' }}
          {%- endif -%}
          <span class="dibi-instagram__hover" aria-hidden="true">
            <svg class="dibi-instagram__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="dibi-instagram__footer">
    <a href="{{ ig_url }}" class="dibi-instagram__follow" target="_blank" rel="noopener noreferrer">
      {{ section.settings.follow_label | default: 'Follow Us' }}
      <svg class="dibi-instagram__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "class": "dibi-instagram-section",
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "follow_label",
      "label": "Follow link label",
      "default": "Follow @dibimilano_skincentre"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Falls back to the profile URL if blank."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "settings": {
        "follow_label": "Follow @dibimilano_skincentre"
      },
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
