{%- comment -%}
  DIBI services grid — matches the "Our Services" section in
  hydrogen/app/routes/_index.tsx. Manual editable blocks for now
  (metaobject wiring is a later phase). Each card: image, name,
  short description, link.
{%- endcomment -%}

<section class="dibi-services" id="dibi-services-{{ section.id }}">
  <div class="dibi-services__inner dibi-container">
    {%- if section.settings.heading != blank -%}
      <div class="dibi-services__head dibi-reveal">
        <h2 class="dibi-services__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="dibi-services__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'service_card' -%}
          {%- liquid
            assign card_url = block.settings.url
            if card_url == blank
              assign card_url = '#'
            endif
          -%}
          <a
            href="{{ card_url }}"
            class="dibi-service-card dibi-reveal"
            {{ block.shopify_attributes }}
          >
            <div class="dibi-service-card__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    widths: '400, 600, 800, 1000',
                    alt: block.settings.title,
                    class: 'dibi-service-card__img'
                }}
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'dibi-service-card__img dibi-service-card__img--placeholder' }}
              {%- endif -%}
            </div>
            <div class="dibi-service-card__overlay"></div>
            <div class="dibi-service-card__body">
              {%- if block.settings.title != blank -%}
                <h3 class="dibi-service-card__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="dibi-service-card__desc">{{ block.settings.description }}</div>
              {%- endif -%}
              <span class="dibi-service-card__link">
                Explore Treatment
                <svg class="dibi-service-card__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services grid",
  "tag": "section",
  "class": "dibi-services-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Services"
    }
  ],
  "blocks": [
    {
      "type": "service_card",
      "name": "Service card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service name"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
