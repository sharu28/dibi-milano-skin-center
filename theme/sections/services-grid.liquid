{%- comment -%}
  DIBI services grid — matches the "Our Services" section in
  hydrogen/app/routes/_index.tsx. Each card: image, name, short description,
  link.

  Two data sources:
    - "metaobject": loop `metaobjects.service.values` (each `service`
      metaobject), linking to its storefront URL (`.system.url`).
    - "blocks": the manual `service_card` blocks below.

  When source is "auto" (default) the section uses metaobjects if any
  `service` entries exist, otherwise falls back to the manual blocks. This
  keeps the section working before the seed script has run.
{%- endcomment -%}

{%- liquid
  assign service_entries = metaobjects.service.values
  assign has_metaobjects = false
  if service_entries.size > 0
    assign has_metaobjects = true
  endif

  assign use_metaobjects = false
  assign source = section.settings.source | default: 'auto'
  if source == 'metaobject'
    assign use_metaobjects = true
  elsif source == 'auto' and has_metaobjects
    assign use_metaobjects = true
  endif
-%}

<section class="dibi-services" id="dibi-services-{{ section.id }}">
  <div class="dibi-services__inner dibi-container">
    {%- if section.settings.heading != blank -%}
      <div class="dibi-services__head dibi-reveal">
        <h2 class="dibi-services__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="dibi-services__grid">
      {%- if use_metaobjects -%}
        {%- for svc in service_entries -%}
          {%- liquid
            assign card_url = svc.system.url | default: '#'
          -%}
          <a href="{{ card_url }}" class="dibi-service-card dibi-reveal">
            <div class="dibi-service-card__media">
              {%- if svc.hero_image.value != blank -%}
                {{
                  svc.hero_image.value
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    widths: '400, 600, 800, 1000',
                    alt: svc.name.value,
                    class: 'dibi-service-card__img'
                }}
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'dibi-service-card__img dibi-service-card__img--placeholder' }}
              {%- endif -%}
            </div>
            <div class="dibi-service-card__overlay"></div>
            <div class="dibi-service-card__body">
              {%- if svc.name.value != blank -%}
                <h3 class="dibi-service-card__title">{{ svc.name.value }}</h3>
              {%- endif -%}
              {%- if svc.short_description.value != blank -%}
                <div class="dibi-service-card__desc">{{ svc.short_description.value }}</div>
              {%- endif -%}
              <span class="dibi-service-card__link">
                Explore Treatment
                <svg class="dibi-service-card__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'service_card' -%}
            {%- liquid
              assign card_url = block.settings.url
              if card_url == blank
                assign card_url = '#'
              endif
            -%}
            <a
              href="{{ card_url }}"
              class="dibi-service-card dibi-reveal"
              {{ block.shopify_attributes }}
            >
              <div class="dibi-service-card__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      widths: '400, 600, 800, 1000',
                      alt: block.settings.title,
                      class: 'dibi-service-card__img'
                  }}
                {%- else -%}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'dibi-service-card__img dibi-service-card__img--placeholder' }}
                {%- endif -%}
              </div>
              <div class="dibi-service-card__overlay"></div>
              <div class="dibi-service-card__body">
                {%- if block.settings.title != blank -%}
                  <h3 class="dibi-service-card__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="dibi-service-card__desc">{{ block.settings.description }}</div>
                {%- endif -%}
                <span class="dibi-service-card__link">
                  Explore Treatment
                  <svg class="dibi-service-card__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services grid",
  "tag": "section",
  "class": "dibi-services-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Services"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Data source",
      "info": "Auto: use Service metaobjects when present, otherwise the manual cards below.",
      "options": [
        { "value": "auto", "label": "Auto (metaobjects, fallback to cards)" },
        { "value": "metaobject", "label": "Service metaobjects" },
        { "value": "blocks", "label": "Manual cards" }
      ],
      "default": "auto"
    }
  ],
  "blocks": [
    {
      "type": "service_card",
      "name": "Service card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service name"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
