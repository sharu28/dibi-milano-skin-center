{%- comment -%}
  DIBI testimonials — matches the star/quote block in
  hydrogen/app/routes/_index.tsx. Each block: star row, quote, author.
{%- endcomment -%}

<section class="dibi-testimonials" id="dibi-testimonials-{{ section.id }}">
  <div class="dibi-testimonials__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="dibi-testimonials__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'testimonial' -%}
        <figure class="dibi-testimonial dibi-reveal" {{ block.shopify_attributes }}>
          <div class="dibi-testimonial__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
            {%- for i in (1..block.settings.stars) -%}
              <svg class="dibi-testimonial__star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.7 7L12 17.8 5.7 21.5l1.7-7L2 9.8l7.1-.6L12 2z"/></svg>
            {%- endfor -%}
          </div>
          {%- if block.settings.quote != blank -%}
            <blockquote class="dibi-testimonial__quote">{{ block.settings.quote }}</blockquote>
          {%- endif -%}
          {%- if block.settings.author != blank -%}
            <figcaption class="dibi-testimonial__author">{{ block.settings.author }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "dibi-testimonials-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>The most incredible facial I've ever had. The team at DIBI Milano truly understands skin and tailors everything to your specific needs. My skin has never looked better!</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah J. — Google Review"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
