{%- comment -%}
  price-menu.liquid

  Renders one service_section's `items` (list.metaobject_reference ->
  service_item) as a price list: name … price, with an optional italic
  description below the name. Mirrors the `menu` layout block in
  hydrogen/app/routes/service.$slug.tsx.

  Accepts:
    section_obj - a `service_section` metaobject drop.

  Field access uses the confirmed `.value` pattern. For a
  list.metaobject_reference field, `.value` returns an array of the
  referenced metaobject drops.
{%- endcomment -%}

{%- assign menu_items = section_obj.items.value -%}
{%- if menu_items and menu_items.size > 0 -%}
  <div class="dibi-price-menu__list">
    {%- for item in menu_items -%}
      <div class="dibi-price-menu__row">
        <div class="dibi-price-menu__info">
          <h4 class="dibi-price-menu__name">{{ item.name.value }}</h4>
          {%- if item.description.value != blank -%}
            <p class="dibi-price-menu__desc"><em>{{ item.description.value }}</em></p>
          {%- endif -%}
        </div>
        <div class="dibi-price-menu__price-wrap">
          <span class="dibi-price-menu__price">{{ item.price.value }}</span>
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}
